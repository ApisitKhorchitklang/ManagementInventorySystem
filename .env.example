# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#   cp .env.example .env
# ---------------------------------------------------------------------------

# พอร์ตของ API server (ไม่ใช่พอร์ตของฐานข้อมูล)
PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory
PGUSER=postgres
PGPASSWORD=postgres

DATABASE_SSL=false
DB_POOL_MAX=10

LOW_STOCK_THRESHOLD=5

CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# ทางเลือก: ใช้ Neon (หรือ PostgreSQL บนคลาวด์) แทนฐานข้อมูลในเครื่อง
# ถ้ามี DATABASE_URL ระบบจะใช้ค่านี้ก่อนตัวแปร PG* ทั้งหมด
#   neon-env export   → พิมพ์ค่า DATABASE_URL / DATABASE_URL_UNPOOLED / NEON_BRANCH
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# NEON_BRANCH=main
