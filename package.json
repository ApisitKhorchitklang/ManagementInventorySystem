{
  "name": "inventory-api",
  "version": "2.0.0",
  "description": "Inventory Management System - Backend API + Web UI (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --with-seed",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "inventory",
    "stock",
    "express",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
